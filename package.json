{
  "name": "tokyo-budget-execution-2026",
  "version": "2026.8.21",
  "private": true,
  "type": "module",
  "description": "東京都の令和7・8年度予算、公金支出、補助金、決算比較データをTypeScriptで扱うための再現可能なデータパッケージ",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "filter:catalog": "node --experimental-strip-types scripts/filter-catalog.ts",
    "normalize": "node --max-old-space-size=3072 --experimental-strip-types scripts/normalize.ts",
    "manifest": "node --experimental-strip-types scripts/build-manifest.ts",
    "checksums": "node --experimental-strip-types scripts/build-checksums.ts",
    "summary": "node --experimental-strip-types scripts/build-package-summary.ts",
    "drilldown": "node --experimental-strip-types scripts/build-drilldown.ts",
    "verify": "node --experimental-strip-types scripts/verify.ts",
    "prepare:data": "pnpm run filter:catalog && pnpm run normalize && pnpm run manifest && pnpm run verify && pnpm run summary",
    "example": "node --experimental-strip-types scripts/example-analysis.ts",
    "fetch:pending": "node --experimental-strip-types scripts/fetch-pending.ts",
    "upload:r2": "node --experimental-strip-types scripts/upload-r2.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src public scripts",
    "format": "oxfmt src public scripts",
    "format:check": "oxfmt --check src public scripts",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "extract:settlement-rows": "node --experimental-strip-types scripts/execution-review/extract-fy2024-settlement-rows.ts",
    "build:execution-records": "node --experimental-strip-types scripts/execution-review/build-fy2024-execution-records.ts",
    "verify:execution": "node --experimental-strip-types scripts/execution-review/verify-fy2024-execution-records.ts",
    "build:execution-scan": "node --experimental-strip-types scripts/execution-review/build-execution-scan.ts",
    "normalize:fy2024-budget": "node --experimental-strip-types scripts/execution-review/normalize-fy2024-budget.ts",
    "normalize:fy2026-budget": "node --experimental-strip-types scripts/execution-review/normalize-fy2026-budget.ts",
    "suggest:mappings": "node --experimental-strip-types scripts/execution-review/suggest-exact-account-mappings.ts",
    "confirm:mappings": "node --experimental-strip-types scripts/execution-review/confirm-exact-account-mappings.ts"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pdfjs-dist": "^6.2.108",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
